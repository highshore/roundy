# Copy to .env.local. Missing credentials never enable demo authentication.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=
# Naver Web Dynamic Map client ID; restrict it to production and local domains.
# Never put a Supabase secret/service_role key in NEXT_PUBLIC variables.
# Match chat (Vercel server only except for the deliberately public API key).
NEXT_PUBLIC_STREAM_CHAT_API_KEY=
STREAM_CHAT_API_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
# PayApp credentials are server-only Supabase Edge Function secrets, never web variables:
# PAYAPP_USER_ID, PAYAPP_LINK_KEY, PAYAPP_LINK_VALUE
# PAYAPP_TAX_MODE=taxable or taxfree (must match the merchant's tax treatment)
# PAYAPP_FRONTEND_URL=https://roundy.team
# Optional: PAYAPP_SHOP_NAME=Roundy, PAYAPP_OPEN_PAY_TYPE=card,kakaopay,naverpay
# Optional for a future native Roundy app: PAYAPP_APP_URL=roundy://payment/result

# NAVER API HUB Local Search (server only).
NAVER_API_HUB_CLIENT_ID=
NAVER_API_HUB_CLIENT_SECRET=
# Naver Cloud Maps Geocoding fallback (server only).
NAVER_MAP_CLIENT_ID=
NAVER_MAP_CLIENT_SECRET=
# Work descriptions send only job/workplace fields, never identity or documents.
OPENAI_API_KEY=
PROFILE_SUMMARY_MODEL=gpt-4.1-mini
# Set in Supabase Edge Function secrets, not in the web bundle:
# KAKAO_APPKEY, KAKAO_SECRET_KEY, KAKAO_SENDER_KEY, KAKAO_TEMPLATE_CODE
